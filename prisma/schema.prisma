datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  role      String    @default("USER")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comments  Comment[]
  apiKeys   ApiKey[]
}

model Category {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String
  icon        String
  color       String   @default("from-brand-500 to-brand-600")
  featured    Boolean  @default(false)
  toolsCount  Int      @default(0)
  createdAt   DateTime @default(now())
}

model Tool {
  id           String         @id @default(uuid())
  slug         String         @unique
  name         String
  category     String
  description  String
  icon         String
  featured     Boolean        @default(false)
  trending     Boolean        @default(false)
  usageCount   Int            @default(0)
  rating       Float          @default(5.0)
  reviewsCount Int            @default(0)
  createdAt    DateTime       @default(now())
  usageLogs    AiUsageLog[]
}

model AiUsageLog {
  id        String   @id @default(uuid())
  toolSlug  String
  tool      Tool     @relation(fields: [toolSlug], references: [slug])
  task      String
  inputLen  Int
  outputLen Int      @default(0)
  model     String   @default("meta-llama/llama-3.1-8b-instruct:free")
  success   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model BlogPost {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  author      String    @default("Toolifia Editorial Team")
  category    String
  readingTime String    @default("5 min read")
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  comments    Comment[]
}

model Comment {
  id        String    @id @default(uuid())
  content   String
  rating    Int       @default(5)
  authorId  String?
  author    User?     @relation(fields: [authorId], references: [id])
  toolSlug  String?
  postId    String?
  post      BlogPost? @relation(fields: [postId], references: [id])
  createdAt DateTime  @default(now())
}

model ApiKey {
  id        String   @id @default(uuid())
  key       String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  createdAt DateTime @default(now())
}

model SystemSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}
